# ==============================================================================
# HorizonScan - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SPLIT DEPLOYMENT SEPARATION CHECKLIST
# ------------------------------------------------------------------------------
#
# FRONTEND (Deploy on Vercel):
#   - NEXT_PUBLIC_BACKEND_URL=https://your-backend-service.onrender.com
#   (Note: Tavily & LLM keys can either be entered in the UI by users or set
#    on the backend container. Frontend only needs the backend URL!)
#
# BACKEND (Deploy on Render - Web Service or Docker):
#   - PORT=4000
#   - NODE_ENV=production
#   - CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:3000
#   - TAVILY_API_KEY=tvly-xxxx
#   - GEMINI_API_KEY=AIzaSy-xxxx (or OPENAI_API_KEY=sk-xxxx)
#   - PLAYWRIGHT_HEADLESS=true
#   - AI_WEBSITE_URL=https://chatgpt.com (if using browser automation)
#   - AI_AUTH_STATE_PATH=.auth/ai-session.json
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 2. Server & Split Deployment Settings
# ------------------------------------------------------------------------------
# Port for standalone Express backend server (Render automatically sets this)
PORT=4000

# Allowed CORS origins for the backend server (comma-separated or wildcard '*')
# Example: https://horizonscan.vercel.app,http://localhost:3000
CORS_ORIGIN=*

# Frontend connection to Backend API (Set in Vercel project settings)
# For local full-stack dev: leave empty (uses /api/scan) or set http://localhost:4000
# For production split deployment: set to your live Render backend URL
NEXT_PUBLIC_BACKEND_URL=

# ------------------------------------------------------------------------------
# 3. Grounding & AI Provider Keys (Configured on Backend or locally)
# ------------------------------------------------------------------------------
# Tavily Search API (Required for web grounding) - https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Gemini Flash API - https://aistudio.google.com
GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here

# OpenAI API - https://platform.openai.com
# OPENAI_API_KEY=sk-your-openai-api-key-here

# ------------------------------------------------------------------------------
# 4. Playwright Browser Automation Layer (Render Service)
# ------------------------------------------------------------------------------
# Set to 'true' in Render/Docker production containers, 'false' for local visual debugging
PLAYWRIGHT_HEADLESS=true

# Custom browser binary path (optional, auto-detected if omitted)
# PLAYWRIGHT_BROWSER_PATH=/usr/bin/google-chrome

# Target AI interface URL
AI_WEBSITE_URL=https://chatgpt.com

# DOM Selectors for target AI website
AI_INPUT_SELECTOR=#prompt-textarea, textarea, div[contenteditable="true"]
AI_SUBMIT_SELECTOR=button[data-testid="send-button"], button[aria-label="Send prompt"], button:has(svg)
AI_RESPONSE_SELECTOR=[data-message-author-role="assistant"], .agent-turn, div.markdown
AI_LOGGED_IN_INDICATOR_SELECTOR=button[data-testid="profile-button"], [aria-label*="User profile"], [data-testid="user-menu-button"], nav

# Authenticated browser session path
AI_AUTH_STATE_PATH=.auth/ai-session.json

# Concurrency & Request Queue Control
AI_MAX_CONCURRENT_REQUESTS=1
AI_RESPONSE_TIMEOUT_MS=120000
AI_NAVIGATION_TIMEOUT_MS=45000
