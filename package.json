{
  "name": "horizonscan",
  "version": "1.0.0",
  "description": "HorizonScan - PESTLE Market Intelligence & Macro Risk Radar",
  "main": "server.ts",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:backend": "tsx server.ts",
    "dev:backend": "tsx watch server.ts",
    "start:frontend": "next start",
    "dev:frontend": "next dev",
    "dev:all": "concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "ai:auth": "node scripts/setup-ai-session.mjs",
    "test:ai": "node tests/playwright-mock.test.mjs"
  },
  "keywords": [
    "pestle",
    "market-intelligence",
    "ai-radar",
    "tavily",
    "playwright"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
